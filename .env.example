# Copy to .env for local development. In production these live in Coolify → Environment Variables.
# Never commit real values.

# Required
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Optional
DATA_DIR=./data
LOG_LEVEL=info
HEALTH_PORT=3000
REGISTER_COMMANDS=true
BACKUP_HOUR_UTC=2
BACKUP_KEEP=7
# ERROR_WEBHOOK_URL=

# Optional off-site backups to Cloudflare R2 (all four required to enable)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PREFIX=sum/
